{
  "expo": {
    "name": "Hound",
    "slug": "hound",
    "scheme": "hound",
    "version": "1.2.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#161826",
    "ios": {
      "bundleIdentifier": "app.hound.mobile",
      "appleTeamId": "CL3XC87U77",
      "supportsTablet": true,
      "associatedDomains": ["applinks:houndchallenge.net"],
      "infoPlist": {
        "NSHealthShareUsageDescription": "Hound reads your steps, distance, workouts, heart rate, weight, water and sleep to score challenges and goals with friends and look after your hound.",
        "NSHealthUpdateUsageDescription": "Hound does not write to Health, but iOS requires this description to be present.",
        "ITSAppUsesNonExemptEncryption": false
      },
      "entitlements": {
        "com.apple.developer.healthkit": true,
        "com.apple.developer.healthkit.access": [],
        "com.apple.developer.applesignin": ["Default"]
      }
    },
    "android": {
      "package": "app.hound.mobile",
      "adaptiveIcon": {
        "backgroundColor": "#161826",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "intentFilters": [
        {
          "action": "VIEW",
          "autoVerify": true,
          "data": [
            { "scheme": "https", "host": "houndchallenge.net", "pathPrefix": "/f/" },
            { "scheme": "https", "host": "houndchallenge.net", "pathPrefix": "/c/" }
          ],
          "category": ["BROWSABLE", "DEFAULT"]
        }
      ],
      "permissions": [
        "android.permission.health.READ_STEPS",
        "android.permission.health.READ_DISTANCE",
        "android.permission.health.READ_EXERCISE",
        "android.permission.health.READ_HEART_RATE",
        "android.permission.health.READ_WEIGHT",
        "android.permission.health.READ_HYDRATION",
        "android.permission.health.READ_SLEEP",
        "android.permission.ACTIVITY_RECOGNITION"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "@bacons/apple-targets",
      [
        "@kingstinct/react-native-healthkit",
        {
          "background": false
        }
      ],
      "./plugins/withHealthConnect.js",
      [
        "@react-native-google-signin/google-signin",
        {
          "iosUrlScheme": "com.googleusercontent.apps.304361422076-1eengk283vh6djddhs582frhiup7ersn"
        }
      ],
      "expo-dev-client",
      [
        "expo-build-properties",
        {
          "ios": {
            "buildReactNativeFromSource": true
          },
          "android": {
            "minSdkVersion": 26
          }
        }
      ],
      "expo-notifications",
      [
        "expo-camera",
        {
          "cameraPermission": "Hound uses the camera to scan a friend's QR code, or to take a photo of your dog for your avatar.",
          "microphonePermission": false,
          "recordAudioAndroid": false
        }
      ],
      "expo-background-task",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Hound shows your pack on the Pack Activity map, only during a Pack Activity you join, and only to that pack.",
          "locationAlwaysAndWhenInUsePermission": "Hound keeps your spot on your pack's Pack Activity map while your phone is locked, only until that Pack Activity ends.",
          "locationAlwaysPermission": "Hound keeps your spot on your pack's Pack Activity map while your phone is locked, only until that Pack Activity ends.",
          "isIosBackgroundLocationEnabled": true,
          "isAndroidBackgroundLocationEnabled": false,
          "isAndroidForegroundServiceEnabled": true
        }
      ],
      [
        "expo-sensors",
        {
          "motionPermission": "Hound counts your steps live during a Pack Activity, so your pack sees them right away."
        }
      ],
      "react-native-maps",
      [
        "expo-image-picker",
        {
          "photosPermission": "Hound uses a photo of your dog for your avatar, if you choose one.",
          "cameraPermission": "Hound uses the camera to scan a friend's QR code, or to take a photo of your dog for your avatar.",
          "microphonePermission": false
        }
      ],
      [
        "expo-widgets",
        {
          "widgets": [
            {
              "name": "HoundGoals",
              "displayName": "Hound",
              "description": "Your hound and today's goals.",
              "supportedFamilies": ["systemSmall", "systemMedium"],
              "contentMarginsDisabled": false
            },
            {
              "name": "HoundSteps",
              "displayName": "Hound steps",
              "description": "Today's steps toward your goal.",
              "supportedFamilies": ["accessoryCircular", "accessoryRectangular", "accessoryInline"],
              "contentMarginsDisabled": false
            }
          ]
        }
      ],
      [
        "react-native-android-widget",
        {
          "widgets": [
            {
              "name": "HoundGoals",
              "label": "Hound",
              "description": "Your hound and today's goals.",
              "minWidth": "110dp",
              "minHeight": "110dp",
              "targetCellWidth": 2,
              "targetCellHeight": 2,
              "maxResizeWidth": "420dp",
              "maxResizeHeight": "220dp",
              "resizeMode": "horizontal|vertical",
              "updatePeriodMillis": 1800000
            }
          ]
        }
      ],
      [
        "react-native-google-mobile-ads",
        {
          "androidAppId": "ca-app-pub-5172900554113864~3767325277",
          "iosAppId": "ca-app-pub-5172900554113864~3364659733",
          "delayAppMeasurementInit": true,
          "skAdNetworkItems": ["cstr6suwn9.skadnetwork"]
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "844311e3-1bd2-4be3-85b1-a8b9c25196b0"
      }
    },
    "owner": "hound-challenge-team",
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/844311e3-1bd2-4be3-85b1-a8b9c25196b0"
    }
  },
  "react-native-google-mobile-ads": {
    "android_app_id": "ca-app-pub-5172900554113864~3767325277",
    "ios_app_id": "ca-app-pub-5172900554113864~3364659733",
    "delay_app_measurement_init": true
  }
}
