{
  "expo": {
    "name": "Hound",
    "slug": "hound",
    "scheme": "hound",
    "version": "0.9.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#161826",
    "ios": {
      "bundleIdentifier": "app.hound.mobile",
      "supportsTablet": true,
      "infoPlist": {
        "NSHealthShareUsageDescription": "Hound reads your steps, distance, heart rate and weight to score challenges with friends.",
        "NSHealthUpdateUsageDescription": "Hound does not write to Health, but iOS requires this description to be present.",
        "ITSAppUsesNonExemptEncryption": false
      },
      "entitlements": {
        "com.apple.developer.healthkit": true,
        "com.apple.developer.healthkit.access": []
      }
    },
    "android": {
      "package": "app.hound.mobile",
      "adaptiveIcon": {
        "backgroundColor": "#161826",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.health.READ_STEPS",
        "android.permission.health.READ_DISTANCE",
        "android.permission.health.READ_HEART_RATE",
        "android.permission.health.READ_WEIGHT",
        "android.permission.health.READ_EXERCISE",
        "android.permission.health.READ_STEPS",
        "android.permission.health.READ_DISTANCE",
        "android.permission.health.READ_HEART_RATE",
        "android.permission.health.READ_WEIGHT",
        "android.permission.health.READ_EXERCISE"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      [
        "@kingstinct/react-native-healthkit",
        {
          "background": false
        }
      ],
      "./plugins/withHealthConnect.js",
      [
        "@react-native-google-signin/google-signin",
        {
          "iosUrlScheme": "com.googleusercontent.apps.304361422076-1eengk283vh6djddhs582frhiup7ersn"
        }
      ],
      "expo-dev-client",
      [
        "expo-build-properties",
        {
          "ios": {
            "buildReactNativeFromSource": true
          },
          "android": {
            "minSdkVersion": 26
          }
        }
      ],
      "expo-notifications"
    ],
    "extra": {
      "eas": {
        "projectId": "844311e3-1bd2-4be3-85b1-a8b9c25196b0"
      }
    },
    "owner": "hound-challenge-team",
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/844311e3-1bd2-4be3-85b1-a8b9c25196b0"
    }
  }
}
